<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container">

    <section class="page-header">
        <div>
            <span class="eyebrow">Inscription</span>
            <h1>Récapitulatif et paiement</h1>
            <p>Vérifiez les informations avant de confirmer</p>
        </div>
    </section>

    <div class="detail-grid">

        <section class="card">

            <div class="card-header">
                <h2>Activité</h2>
            </div>

            <div class="card-content">

                <% if (activity) { %>

                    <div class="info-row">
                        <span>Activité</span>
                        <strong><%= activity.name %></strong>
                    </div>

                    <div class="info-row">
                        <span>Sport</span>
                        <strong><%= activity.sport_type %></strong>
                    </div>

                    <div class="info-row">
                        <span>Tarif de base</span>
                        <strong><%= activity.base_price %> MAD</strong>
                    </div>

                <% } %>

                <% if (member) { %>

                    <div class="info-row">
                        <span>Adhérent</span>
                        <strong>
                            <%= member.first_name %>
                            <%= member.last_name %>
                        </strong>
                    </div>

                <% } %>

            </div>

        </section>


        <section class="card">

            <div class="card-header">
                <h2>Calcul du tarif</h2>
            </div>

            <div class="card-content">

                <div class="price-box">
                    <span>Prix final</span>

                    <strong id="price_result">
                        <%= finalPrice || (activity ? activity.base_price : 0) %> MAD
                    </strong>
                </div>


                <% if (!member) { %>

                    <div class="error-message">
                        Membre introuvable.
                    </div>

                <% } else if (!activity) { %>

                    <div class="error-message">
                        Activité introuvable.
                    </div>

                <% } else { %>

                    <form method="POST" action="/registrations">

                        <input
                            type="hidden"
                            name="member_id"
                            value="<%= member.id %>"
                        >

                        <input
                            type="hidden"
                            name="activity_id"
                            value="<%= activity.id %>"
                        >

                        <input
                            type="hidden"
                            id="base_price"
                            value="<%= activity.base_price %>"
                        >


                        <div class="form-group">

                            <label>
                                <input
                                    type="checkbox"
                                    id="is_resident"
                                    name="is_resident"
                                    <%= member.is_resident ? 'checked' : '' %>
                                    disabled
                                >

                                Résident
                            </label>

                        </div>


                        <div class="form-group">

                            <label for="family_member_count">
                                Nombre de membres de la famille
                            </label>

                            <input
                                type="number"
                                id="family_member_count"
                                name="family_member_count"
                                min="1"
                                value="<%= familyMemberCount || 1 %>"
                                disabled
                            >

                        </div>


                        <div class="form-group">

                            <label for="quotient_familial">
                                Quotient familial
                            </label>

                            <input
                                type="number"
                                id="quotient_familial"
                                name="quotient_familial"
                                min="0"
                                value="<%= quotientFamilial || 0 %>"
                                disabled
                            >

                        </div>


                        <div class="form-group">

                            <label>

                                <input
                                    type="checkbox"
                                    id="has_pass_sport"
                                    name="has_pass_sport"
                                    <%= hasPassSport ? 'checked' : '' %>
                                    disabled
                                >

                                Pass'Sport

                            </label>

                        </div>


                        <div class="form-group">

                            <label for="payment_plan">
                                Plan de paiement
                            </label>

                            <select
                                id="payment_plan"
                                name="payment_plan"
                            >

                                <option value="1x">
                                    Paiement en 1 fois
                                </option>

                                <option value="3x">
                                    Paiement en 3 fois
                                </option>

                            </select>

                        </div>


                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Confirmer l'inscription
                        </button>

                    </form>

                <% } %>

            </div>

        </section>

    </div>

</main>

<%- include('../partials/footer') %>