<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container">

```
<section class="page-header">
    <div>
        <span class="eyebrow">Infrastructure</span>

        <h1>
            <%= facility ? 'Modifier une installation' : 'Ajouter une installation' %>
        </h1>

        <p>
            <%= facility
                ? 'Modifier les informations de cette installation sportive'
                : 'Ajouter une nouvelle installation sportive'
            %>
        </p>
    </div>
</section>

<section class="form-section">

    <form
        id="facilityForm"
        action="<%= facility ? '/facilities/' + facility.id : '/facilities' %>"
    >

        <div class="form-group">
            <label for="name">Nom de l'installation</label>

            <input
                type="text"
                id="name"
                name="name"
                value="<%= facility ? facility.name : '' %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="type">Type d'installation</label>

            <input
                type="text"
                id="type"
                name="type"
                value="<%= facility ? (facility.type || '') : '' %>"
                placeholder="Ex : Piscine, Terrain, Salle..."
                required
            >
        </div>

        <div class="form-group">
            <label for="erp_capacity">Jauge ERP</label>

            <input
                type="number"
                id="erp_capacity"
                name="erp_capacity"
                value="<%= facility ? facility.erp_capacity : '' %>"
                min="1"
                required
            >
        </div>

        <div class="form-group">
            <label for="is_divisible">
                Installation divisible
            </label>

            <select id="is_divisible" name="is_divisible">

                <option
                    value="false"
                    <%= facility && !facility.is_divisible ? 'selected' : '' %>
                >
                    Non
                </option>

                <option
                    value="true"
                    <%= facility && facility.is_divisible ? 'selected' : '' %>
                >
                    Oui
                </option>

            </select>
        </div>

        <div class="form-actions">

            <a href="/facilities" class="btn btn-secondary">
                Annuler
            </a>

            <button type="submit" class="btn btn-primary">
                <%= facility ? 'Modifier' : 'Ajouter' %>
            </button>

        </div>

    </form>

</section>
```

</main>

<%- include('../partials/footer') %>

<script>

    const form = document.getElementById('facilityForm');

    form.addEventListener('submit', async function(event) {

        event.preventDefault();

        const data = {

            name: document.getElementById('name').value,

            type: document.getElementById('type').value,

            erp_capacity: Number(
                document.getElementById('erp_capacity').value
            ),

            is_divisible:
                document.getElementById('is_divisible').value === 'true'
        };

        try {

            const response = await fetch(form.action, {

                method: '<%= facility ? "PUT" : "POST" %>',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(data)

            });

            if (!response.ok) {
                throw new Error(
                    'Erreur lors de l\'enregistrement'
                );
            }

            window.location.href = '/facilities';

        } catch (error) {

            console.error(error);

            alert(
                'Erreur lors de l\'enregistrement de l\'installation'
            );

        }

    });

</script>
