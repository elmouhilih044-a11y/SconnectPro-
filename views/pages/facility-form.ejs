<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container">

    <section class="page-header">
        <div>
            <span class="eyebrow">Infrastructure</span>

            <h1>
                <%= facility ? 'Modifier une installation' : 'Ajouter une installation' %>
            </h1>

            <p>
                <%= facility
                    ? 'Modifier les informations de cette installation sportive'
                    : 'Ajouter une nouvelle installation sportive'
                %>
            </p>
        </div>
    </section>


    <section class="form-section">

        <form
            id="facilityForm"
            method="POST"
            action="<%= facility ? '/facilities/' + facility.id : '/facilities' %>"
        >

            <!-- Nom -->
            <div class="form-group">
                <label for="name">Nom de l'installation</label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= facility ? facility.name : '' %>"
                    required
                >
            </div>


            <!-- Localisation -->
            <div class="form-group">
                <label for="location">Localisation</label>

                <input
                    type="text"
                    id="location"
                    name="location"
                    value="<%= facility ? (facility.location || '') : '' %>"
                    required
                >
            </div>


            <!-- Capacité ERP -->
            <div class="form-group">
                <label for="erp_capacity">Jauge ERP</label>

                <input
                    type="number"
                    id="erp_capacity"
                    name="erp_capacity"
                    value="<%= facility ? facility.erp_capacity : '' %>"
                    min="1"
                    required
                >
            </div>


            <!-- Installation divisible -->
            <div class="form-group">
                <label for="is_divisible">
                    Installation divisible
                </label>

                <select id="is_divisible" name="is_divisible">
                    <option
                        value="false"
                        <%= facility && !facility.is_divisible ? 'selected' : '' %>
                    >
                        Non
                    </option>

                    <option
                        value="true"
                        <%= facility && facility.is_divisible ? 'selected' : '' %>
                    >
                        Oui
                    </option>
                </select>
            </div>


            <!-- Boutons -->
            <div class="form-actions">

                <a href="/facilities" class="btn btn-secondary">
                    Annuler
                </a>

                <button type="submit" class="btn btn-primary">
                    <%= facility ? 'Modifier' : 'Ajouter' %>
                </button>

            </div>

        </form>

    </section>

</main>

<%- include('../partials/footer') %>


<script>
    const form = document.getElementById('facilityForm');

    form.addEventListener('submit', async function(event) {
        event.preventDefault();

        const formData = new FormData(form);

        const data = {
            name: formData.get('name'),
            location: formData.get('location'),
            erp_capacity: Number(formData.get('erp_capacity')),
            is_divisible: formData.get('is_divisible') === 'true'
        };

        try {
            const response = await fetch(form.action, {
                method: '<%= facility ? "PUT" : "POST" %>',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                throw new Error('Erreur lors de l'enregistrement');
            }

            window.location.href = '/facilities';

        } catch (error) {
            console.error(error);
            alert('Erreur serveur');
        }
    });
</script>