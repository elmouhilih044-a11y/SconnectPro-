<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container">

    <section class="page-header">

        <div>
            <span class="eyebrow">Adhérents</span>
            <h1>Registre des adhérents</h1>
            <p>Gestion des membres et de leur situation médicale</p>
        </div>

        <a href="/members/new" class="btn btn-primary">
            Ajouter un adhérent
        </a>

    </section>

    <% if (members && members.length > 0) { %>

        <div class="table-container">

            <table>

                <thead>

                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Date de naissance</th>
                        <th>Résident</th>
                        <th>Certificat médical</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% members.forEach(function(member) { %>

                        <tr>

                            <td>
                                <strong>
                                    <%= member.first_name %>
                                    <%= member.last_name %>
                                </strong>
                            </td>

                            <td>
                                <%= member.email || '-' %>
                            </td>

                            <td>
                                <%= member.birth_date || '-' %>
                            </td>

                            <td>
                                <% if (member.is_resident) { %>
                                    <span class="status-badge">Oui</span>
                                <% } else { %>
                                    <span class="status-badge status-muted">Non</span>
                                <% } %>
                            </td>

                            <td>
                                <% if (member.medical_certificate_date) { %>
                                    <span class="status-badge">Présent</span>
                                <% } else { %>
                                    <span class="status-badge status-danger">Manquant</span>
                                <% } %>
                            </td>

                            <td>
                                <a
                                    href="/members/<%= member.id %>"
                                    class="btn btn-small btn-secondary"
                                >
                                    Voir
                                </a>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } else { %>

        <div class="empty-state">
            <h3>Aucun adhérent</h3>
            <p>Le registre ne contient aucun adhérent.</p>
        </div>

    <% } %>

</main>

<%- include('../partials/footer') %>